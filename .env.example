# ─────────────────────────────────────────────────────────────────
# Variables de entorno del chatbot (Vercel → Project → Settings →
# Environment Variables). Para probar en local: copia a .env y ejecuta
#   node --env-file=.env scripts/chat-dev.mjs
# NUNCA subas el archivo .env real a GitHub.
# ─────────────────────────────────────────────────────────────────

# Claves de IA gratuitas (basta con UNA; cuantas más pongas, más respaldo)
MISTRAL_API_KEY=        # https://console.mistral.ai  (capa gratuita: 1 petición/s, ~1.000 M tokens/mes)
GEMINI_API_KEY=         # https://aistudio.google.com/apikey
GROQ_API_KEY=           # https://console.groq.com/keys
OPENROUTER_API_KEY=     # https://openrouter.ai/keys  (modelos ":free")
# DEEPSEEK_API_KEY=     # opcional y de pago; el tutor ya NO lo necesita

# Orden de proveedores (opcional). Por defecto: mistral,gemini,groq,openrouter
# LLM_PROVIDERS=mistral,gemini,groq,openrouter
# Modelos por proveedor (opcional, separados por coma, el 1.º es el preferido)
# MISTRAL_MODELS=mistral-small-latest,open-mistral-nemo
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
# Lista exacta y ordenada de "proveedor:modelo" (ignora las dos anteriores)
# LLM_TARGETS=mistral:mistral-small-latest,gemini:gemini-flash-latest,groq:openai/gpt-oss-20b

# Protección anti-abuso (opcional)
# CHAT_RATE_MIN=8          # mensajes por minuto y por IP
# CHAT_RATE_DAY=80         # mensajes por día y por IP
# CHAT_GLOBAL_DAY=4000     # tope global diario (solo con Upstash)
# CHAT_MAX_TOKENS=700      # longitud máxima de cada respuesta
# ALLOWED_ORIGINS=         # dominios extra permitidos, separados por coma
# CHAT_DEBUG_TOKEN=        # con él, GET /api/chat (cabecera x-debug-token) muestra la salud de cada modelo

# Contadores y estado de salud compartidos entre instancias (opcional, gratis):
# crea una base en https://upstash.com (o Vercel Marketplace → Upstash Redis)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Dominio público para los enlaces que da el bot (por defecto el de producción)
# SITE_URL=https://sitialtalento.vercel.app

# ── Internet en tiempo real (opcional) ────────────────────────────────
# Sin clave se usa Wikipedia (gratis). Con TAVILY_API_KEY (plan gratuito mensual, tavily.com) las
# preguntas de actualidad se responden con resultados web recientes.
TAVILY_API_KEY=
# WEB_TIMEOUT_MS=4500

# ── Tutor del Banco de Problemas (gratuito) ───────────────────────────
# Usa las mismas claves de Gemini / Mistral / Groq / OpenRouter de arriba (DeepSeek ya no hace falta).
# TUTOR_VISION=gemini:gemini-flash-latest,mistral:mistral-small-latest,groq:meta-llama/llama-4-scout-17b-16e-instruct
# TUTOR_GRADERS=gemini:gemini-flash-latest,mistral:mistral-small-latest,groq:openai/gpt-oss-120b
# TUTOR_FAST=groq:openai/gpt-oss-120b,mistral:mistral-small-latest,gemini:gemini-flash-latest
# TUTOR_DUAL=1        # 0 = un solo calificador (más rápido, menos cuota)
# TUTOR_HINT_DAY=40
# TUTOR_GRADE_DAY=8
# TUTOR_GLOBAL_DAY=300

# ── Campo vectorial ───────────────────────────────────────────────────
# Opcional: genera Data/vectores.json con `GEMINI_API_KEY=… node scripts/build-vectores.mjs`
# CHAT_VECTORS=0        # desactiva la capa semántica (queda la local)
# EMBED_PROVIDER=gemini # o mistral (al generar los vectores)
# EMBED_TIMEOUT_MS=2500
# TUTOR_CHAT_DAY=60     # preguntas/día por IP al chat sobre la solución
